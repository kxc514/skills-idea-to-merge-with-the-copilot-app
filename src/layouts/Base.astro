---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light dark;
        --accent: #6d28d9;
        --border: #d8d3e4;
        --muted: #625b73;
        --surface: #fff;
        --radius: 0.85rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html {
        min-height: 100%;
        background: radial-gradient(ellipse at top left, #e8ddff, transparent 60%), #f6f5fa;
        color: #292236;
      }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 52rem;
        margin: 0 auto;
        padding: 4rem 1.25rem;
      }
      header { margin-bottom: 2rem; }
      main {
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 1.25rem;
        background: var(--surface);
        box-shadow: 0 16px 48px #2922360d;
      }
      h1 { margin: 0 0 0.25rem; font-size: 1.75rem; font-family: var(--font-head); letter-spacing: -0.01em; }
      .tagline { margin: 0; color: var(--muted); }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 0 0 0.75rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: color-mix(in srgb, var(--accent) 3%, var(--surface));
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible,
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { filter: brightness(1.05); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      #bookmark-status { font-size: 0.85rem; overflow-wrap: anywhere; }
      #bookmark-status:empty { display: none; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.5rem 0;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.75rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }
      .bookmark-text { flex: 1 1 16rem; overflow-wrap: anywhere; white-space: pre-wrap; }
      .bookmark .url { color: var(--accent); text-underline-offset: 3px; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 18%, transparent);
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
      }

      footer { margin-top: 2.5rem; font-size: 0.8rem; color: var(--muted); }
      @media (prefers-color-scheme: dark) {
        :root {
          --accent: #c4a6ff;
          --border: #443b56;
          --muted: #b6adc6;
          --surface: #211b2c;
        }
        html { background: radial-gradient(ellipse at top left, #34224e, transparent 60%), #16111e; color: #f0eaf8; }
        button { color: #211b2c; }
        .clear, .bookmark .copy { color: inherit; }
      }
      @media (max-width: 480px) {
        body { padding-top: 2rem; }
        main { padding: 1rem; }
        h1 { font-size: 1.45rem; }
        form > button { width: 100%; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
